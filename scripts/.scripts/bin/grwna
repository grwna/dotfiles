#!/bin/bash

usage() {
    cat <<'EOF'
Usage: grwna -h

Commands:
  cs <topic>       Open a cheatsheet
  ag [agent]       Copy skills for an agent
  cr <file.cpp>    Compile and run a C++ file
  tm <topic>       Print a template
EOF
}

if [ "$#" -eq 1 ] && [ "$1" = -h ]; then
    usage
    exit 0
fi

if [ "$#" -eq 0 ]; then
    echo "Error: missing command." >&2
else
    echo "Error: unknown command '$*'." >&2
fi
usage >&2
exit 1 

#!/bin/bash

usage() {
    cat <<'EOF'
Usage: gw -h

Commands:
  cs <topic>              Open a cheatsheet
  ag <command>            Copy skills for an agent
  cr <file.cpp>           Compile and run a C++ file
  tm <topic>              Print a template
  switch-docker <flag>    Switch docker context (windows vs linux)  
EOF
}

if [ "$#" -eq 1 ] && [ "$1" = -h ]; then
    usage
    exit 0
fi

if [ "$#" -eq 0 ]; then
    echo "Error: missing command." >&2
    usage >&2
    exit 1
fi

case "$1" in
    -*)
        echo "Error: unknown option '$1'." >&2
        usage >&2
        exit 1
        ;;
    *)
        "$@"
        ;;
esac

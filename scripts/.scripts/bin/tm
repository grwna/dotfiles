#!/bin/bash

BASE_DIR="$HOME/.scripts/dependencies/templates/"

show_templates(){
    echo "--- Available templates ---"
    ls "$BASE_DIR" | sed 's/\.[^.]*$//' 
}

if [ ! -d "$BASE_DIR" ]; then
    echo "Error: $BASE_DIR does not exist."
fi


# argument check
if [ -z "$1" ]; then
    echo "Usage: tm <topic>"
    show_templates
    exit 1
fi

# match file with argument
# -maxdepth 1: Only looks in the base folder 
FILE=$(find -L "$BASE_DIR" -maxdepth 1 -iname "$1.*" -type f | head -n 1)

if [ -n "$FILE" ]; then
    batcat -p --paging=never  "$FILE"
else
    echo "No templates found for '$1' in $BASE_DIR"
    show_templates
fi
